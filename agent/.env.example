# LLM Configuration for Kimi (moonshot)
# Copy this file to .env and fill in your API key.
# The .env file is excluded from git by .gitignore.

MODEL_PROVIDER=moonshot
MODEL_NAME=kimi-k2-0711-preview
MODEL_BASE_URL=https://api.moonshot.cn/v1

# Your Kimi API key (get from https://platform.moonshot.cn/)
MOONSHOT_API_KEY=

LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_TOP_K_CANDIDATES=12
